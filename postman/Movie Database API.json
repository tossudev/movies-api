                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "const suffix = `${Date.now()}-${Math.floor(Math.random() * 1000000)}`;",
                  "pm.collectionVariables.set('actorName', `Postman actor ${suffix}`);",
                  "pm.collectionVariables.set('actorBirthDate', '2000-01-01');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "pm.test('Status code is 201', () => pm.expect(pm.response.code).to.equal(201));",
                  "const actor = pm.response.json();",
                  "pm.test('Response contains the created actor', () => {",
                  "  pm.expect(actor.id).to.be.a('number');",
                  "  pm.expect(actor.name).to.eql(pm.collectionVariables.get('actorName'));",
                  "});",
                  "pm.collectionVariables.set('actorID', actor.id);"
                ]
              }
            }
          ]
        },
